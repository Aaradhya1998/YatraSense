flowchart TD

subgraph group_users_views["Users &amp; Views"]
  node_tourist_dashboard["Tourist Dashboard<br/>[app.js]"]
  node_authority_dashboard["Authority Dashboard"]
  node_firebase_auth["Firebase Auth<br/>[firebase-auth.js]"]
end

subgraph group_api_orchestration["API Orchestration"]
  node_fastapi_backend["FastAPI Backend<br/>[main.py]"]
end

subgraph group_crowd_intelligence["Crowd Intelligence"]
  node_cv_engine["CV Engine<br/>[cv_engine.py]"]
  node_density_classifier["Density Classifier"]
  node_gps_engine["GPS Clustering<br/>[gps_engine.py]"]
end

subgraph group_prediction_alerts["Prediction &amp; Alerts"]
  node_predictive_engine["Predictive Engine"]
  node_alert_service["Alert Service<br/>[alert_service.py]"]
end

subgraph group_data_integrations["Data &amp; Integrations"]
  node_video_assets["Sample Videos"]
  node_monument_info[("Monument Data<br/>[monument_info.json]")]
  node_historical_pattern[("Historical Pattern")]
  node_gps_checkins[("GPS Check-ins<br/>[gps_checkins.json]")]
  node_firebase[("Firebase Firestore")]
end

node_tourist(("Tourist"))
node_authority(("Site Authority"))

node_tourist -->|"uses"| node_tourist_dashboard
node_authority -->|"uses"| node_authority_dashboard
node_tourist_dashboard -->|"requests data"| node_fastapi_backend
node_authority_dashboard -->|"requests status"| node_fastapi_backend
node_firebase_auth -.->|"stores profiles"| node_firebase
node_tourist_dashboard -.->|"authenticates"| node_firebase_auth
node_tourist_dashboard -.->|"stores SOS"| node_firebase
node_authority_dashboard -.->|"reads SOS"| node_firebase
node_fastapi_backend -->|"reads info"| node_monument_info
node_fastapi_backend -->|"runs analysis"| node_cv_engine
node_cv_engine -->|"reads frames"| node_video_assets
node_fastapi_backend -->|"classifies counts"| node_density_classifier
node_fastapi_backend -->|"gets forecast"| node_predictive_engine
node_predictive_engine -->|"reads patterns"| node_historical_pattern
node_fastapi_backend -->|"checks alerts"| node_alert_service
node_fastapi_backend -->|"gets GPS density"| node_gps_engine
node_gps_engine -->|"reads check-ins"| node_gps_checkins
node_gps_engine -->|"writes check-ins"| node_gps_checkins
node_tourist_dashboard -->|"posts check-in"| node_fastapi_backend
node_tourist_dashboard -->|"posts SOS"| node_fastapi_backend

